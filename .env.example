# 複製此檔為 .env 後依需求修改（.env 不會被提交到 git）

# --- 憑證到期政策 ---
EXPIRY_WARNING_DAYS=7
# demo 建議設短一點（如 60 秒）才能馬上看到掃描與通知效果；正式環境建議 3600（每小時）以上
SCAN_INTERVAL_SECONDS=60

# --- Chat 通知：slack | discord | console ---
# 未設定 webhook 時會自動退回 console（在服務 log 印出通知內容），demo 仍可正常運作
CHAT_PROVIDER=console
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# --- 模擬設備 API（docker-compose 預設值，本機執行請視情況調整 host/port） ---
F5_API_BASE_URL=http://localhost:9001
ISE_API_BASE_URL=http://localhost:9002
F5_API_TOKEN=demo-f5-token
ISE_API_TOKEN=demo-ise-token
